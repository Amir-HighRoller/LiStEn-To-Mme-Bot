cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets
.env

# Database
*.db
*.sqlite
*.sqlite3

# Temporary media
downloads/
tmp/
temp/

# OS / Editor
.DS_Store
.vscode/
.idea/
EOF